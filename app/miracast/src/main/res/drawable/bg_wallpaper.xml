<?xml version="1.0" encoding="utf-8"?>
<!-- обои по умолчанию: глубокий сине-фиолетовый градиент с мягким свечением сверху слева -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/wall_bottom"
                android:startColor="@color/wall_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="0.1"
                android:endColor="#00000000"
                android:gradientRadius="900dp"
                android:startColor="@color/wall_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
