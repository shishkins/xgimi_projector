<?xml version="1.0" encoding="utf-8"?>
<!-- обои по умолчанию: глубокий синий, светлее справа сверху, почти чёрный внизу слева -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:endColor="@color/wall_bottom"
                android:startColor="@color/wall_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.05"
                android:endColor="#00000000"
                android:gradientRadius="1100dp"
                android:startColor="@color/wall_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
