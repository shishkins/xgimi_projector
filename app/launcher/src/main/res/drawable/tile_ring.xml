<?xml version="1.0" encoding="utf-8"?>
<!-- рамка поверх плитки главного ряда (рисуется над картинкой): в фокусе — белая -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="90">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/tile_idle_stroke" />
        </shape>
    </item>
</selector>
