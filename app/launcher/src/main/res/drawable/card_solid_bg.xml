<?xml version="1.0" encoding="utf-8"?>
<!-- плитка панели настроек поверх видео: непрозрачная, в фокусе белая -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="110"
    android:exitFadeDuration="110">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_solid" />
        </shape>
    </item>
</selector>
