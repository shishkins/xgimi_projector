<?xml version="1.0" encoding="utf-8"?>
<!-- значок в шапке: в покое — едва заметный круг, в фокусе — как карточка -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/tile_focused" />
            <stroke
                android:width="3dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tile_idle" />
        </shape>
    </item>
</selector>
