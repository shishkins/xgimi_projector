<?xml version="1.0" encoding="utf-8"?>
<!-- карточка наших экранов: в покое — едва заметное стекло, в фокусе — светлее с белой рамкой -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card_focused" />
            <stroke
                android:width="2dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card_idle" />
        </shape>
    </item>
</selector>
