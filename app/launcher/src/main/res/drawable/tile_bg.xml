<?xml version="1.0" encoding="utf-8"?>
<!-- «стеклянная» карточка; в фокусе — светлее и с белой рамкой -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tile_focused" />
            <stroke
                android:width="3dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tile_idle" />
            <stroke
                android:width="1dp"
                android:color="@color/tile_idle_stroke" />
        </shape>
    </item>
</selector>
