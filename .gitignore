# Проектная документация и ТЗ — НЕ публикуем (по требованию владельца)
docs/

# Снимки устройства могут содержать серийники/MAC — не коммитим без проверки
device/snapshots/

# Локальный конфиг устройства (MAC/IP) — не публикуем
device/*.local.json

# Фото владельца с наклейки: серийный номер, проводной MAC, 入网号 — не публикуем
